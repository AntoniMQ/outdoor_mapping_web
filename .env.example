# ---------------------------------------------------------------------------
# TrailLoop configuration
# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development

# fixture = deterministic synthetic data, no credentials required (default)
# live    = use the configured upstream providers
APP_DATA_MODE=fixture

# ----------------------------------------------------------------- public ---
NEXT_PUBLIC_APP_NAME=TrailLoop
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any MapLibre style JSON. OpenFreeMap needs no token.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --------------------------------------------------------------- database ---
# Optional. Without it the app runs in reduced mode with in-memory caching.
DATABASE_URL=postgresql://trailloop:trailloop@localhost:5432/trailloop

# ---------------------------------------------------------------- routing ---
# valhalla | openrouteservice | fixture
#
# valhalla         needs NO API key. The FOSSGIS instance below is the engine
#                  behind OpenStreetMap.org's cycling and walking directions.
#                  This is the recommended way to run fully live with no credentials.
# openrouteservice needs ORS_API_KEY (free tier available).
ROUTING_PROVIDER=fixture
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# --------------------------------------------------------- rights of way ---
# overpass | postgis | fixture
RIGHTS_OF_WAY_PROVIDER=fixture
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# -------------------------------------------------------------- geocoding ---
# nominatim | fixture
GEOCODING_PROVIDER=fixture
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# -------------------------------------------------------------- elevation ---
# open-meteo | fixture | none
ELEVATION_PROVIDER=fixture
ELEVATION_BASE_URL=https://api.open-meteo.com

# ------------------------------------------------------------- operational ---
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
UPSTREAM_TIMEOUT_MS=15000
MAX_BBOX_AREA_SQ_KM=400
ROUTE_CANDIDATE_CONCURRENCY=4
# Circular candidates generated per request. Providers may cap this lower:
# the shared Valhalla instance is limited to 12 candidates at concurrency 2.
CIRCULAR_CANDIDATE_COUNT=24
# Wall-clock budget for circular generation. Keep below your platform's function
# timeout (Vercel Hobby is 60s): generation returns its best candidates so far
# when the budget expires instead of failing with a 504.
ROUTE_GENERATION_BUDGET_MS=40000
# Sent as the User-Agent contact for Overpass and Nominatim (their usage policies require it).
CONTACT_EMAIL=you@example.org
